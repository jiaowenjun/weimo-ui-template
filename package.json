{
  "name": "weimo-ui-template",
  "version": "0.1.0",
  "description": "Reusable site shell and content primitives for Weimo UI documentation sites.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui-template.git"
  },
  "homepage": "https://github.com/jiaowenjun/weimo-ui-template#readme",
  "packageManager": "pnpm@12.10.1",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/site-template": {
      "types": "./dist/components/site-template/site-template.d.ts",
      "import": "./dist/components/site-template/site-template.js"
    },
    "./components/site-template-model": {
      "types": "./dist/components/site-template/site-template-model.d.ts",
      "import": "./dist/components/site-template/site-template-model.js"
    },
    "./styles/base.css": {
      "types": "./dist/styles/base.d.css.ts",
      "default": "./dist/styles/base.css"
    },
    "./styles/site-template.css": {
      "types": "./dist/components/site-template/site-template.d.css.ts",
      "default": "./dist/components/site-template/site-template.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test": "vitest run",
    "test:site": "node scripts/site-contract.mjs",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "verify": "pnpm typecheck && pnpm test && pnpm test:site && pnpm check:package && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.54.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.9.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "weimo-ui-core": "git+https://github.com/jiaowenjun/weimo-ui-core.git#57b6e390c3afcbbbd32720e792e7852fed8e9d83"
  }
}
